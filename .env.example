# ==============================================================================
# Student Project Lifecycle Management System (SPLM)
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this template to .env before starting the application in local or production.
# - DO NOT commit real secrets, private keys, or passwords to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration
# ------------------------------------------------------------------------------
# Port on which the Express HTTP backend listens (Required, default: 5000)
PORT=5000

# Runtime environment: 'development' | 'production' | 'test' (Required, default: development)
NODE_ENV=development

# Allowed CORS client origin URL (Required in production for cross-origin credentials)
# In development: http://localhost:5173 (Vite dev server)
# In Docker/Production: http://localhost:3000 (Nginx web client)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. MongoDB Database Configuration (Primary Data Store)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Required)
# Local standalone: mongodb://127.0.0.1:27017/splm_db
# Docker Compose: mongodb://mongodb:27017/splm_db
# Cloud / Replica Set: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/splm_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/splm_db

# ------------------------------------------------------------------------------
# 3. Redis Session Store Configuration (Authoritative Refresh Token Store)
# ------------------------------------------------------------------------------
# Redis hostname or container name (Required, default: localhost)
# Local: localhost | Docker: redis
REDIS_HOST=localhost

# Redis server port (Required, default: 6379)
REDIS_PORT=6379

# Redis password (Optional; leave blank if no authentication is configured)
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. JSON Web Token (JWT) Security Configuration
# ------------------------------------------------------------------------------
# High-entropy cryptographic secret for signing short-lived Access Tokens (Required)
# Minimum 32 random characters recommended for production.
# Generate via: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_min_32_chars_random_string

# High-entropy cryptographic secret for signing long-lived Refresh Tokens (Required)
# Minimum 32 random characters recommended for production.
# Generate via: openssl rand -base64 32
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_chars_random_string

# Access token expiry duration (Default: 15m)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token expiry duration (Default: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. Document Storage & Upload Limits
# ------------------------------------------------------------------------------
# Relative or absolute directory for storing uploaded project deliverables (Required, default: uploads)
UPLOAD_DIR=uploads

# Maximum allowed file upload size per deliverable in Megabytes (Required, default: 25)
MAX_FILE_SIZE_MB=25

