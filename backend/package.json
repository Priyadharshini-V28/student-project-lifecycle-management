{
  "name": "splm-backend",
  "version": "1.0.0",
  "description": "Student Project Lifecycle Management Platform — Backend API Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "tsx src/db/seed.ts",
    "db:verify": "tsx src/db/verify_schema.ts",
    "test:auth": "tsx src/db/test_auth.ts",
    "test:profile": "tsx src/db/test_profile.ts",
    "test:student-dashboard": "tsx src/db/test_student_dashboard.ts",
    "test:faculty-dashboard": "tsx src/db/test_faculty_dashboard.ts",
    "test:proposals": "tsx src/db/test_proposals.ts",
    "test:allocation": "tsx src/db/test_allocation.ts",
    "test:refinements": "tsx src/db/test_refinements.ts",
    "test:milestones": "tsx src/db/test_milestones.ts",
    "test:documents": "tsx src/db/test_documents.ts",
    "test:notifications": "tsx src/db/test_notifications.ts",
    "test:evaluation": "tsx src/db/test_evaluation.ts",
    "test:e2e": "tsx src/db/test_e2e_integration.ts",
    "test:all": "tsx src/db/test_auth.ts && tsx src/db/test_profile.ts && tsx src/db/test_student_dashboard.ts && tsx src/db/test_faculty_dashboard.ts && tsx src/db/test_proposals.ts && tsx src/db/test_allocation.ts && tsx src/db/test_refinements.ts && tsx src/db/test_milestones.ts && tsx src/db/test_documents.ts && tsx src/db/test_notifications.ts && tsx src/db/test_evaluation.ts && tsx src/db/test_e2e_integration.ts",
    "test": "npm run test:all"
  },
  "keywords": [
    "education",
    "project-management",
    "express",
    "typescript",
    "postgresql",
    "redis"
  ],
  "author": "AIDS Department",
