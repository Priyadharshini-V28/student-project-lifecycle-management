{
  "name": "splm-backend",
  "version": "1.0.0",
  "description": "Student Project Lifecycle Management Platform — Backend API Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "build": "rimraf dist && tsc && node -e \"const fs = require('fs'); fs.mkdirSync('dist/db/migrations', { recursive: true }); fs.copyFileSync('src/db/migrations/001_create_tables.sql', 'dist/db/migrations/001_create_tables.sql'); fs.copyFileSync('src/db/migrations/002_seed_data.sql', 'dist/db/migrations/002_seed_data.sql');\"",
    "start": "node dist/server.js",
    "db:migrate": "ts-node-dev --transpile-only src/db/migrate.ts",
    "db:seed": "ts-node-dev --transpile-only src/db/seed.ts",
    "db:setup": "ts-node-dev --transpile-only src/db/migrate.ts && ts-node-dev --transpile-only src/db/seed.ts",
    "db:verify": "ts-node-dev --transpile-only src/db/verify_schema.ts",
    "test:auth": "ts-node-dev --transpile-only src/db/test_auth.ts",
    "test:profile": "ts-node-dev --transpile-only src/db/test_profile.ts",
    "test:student-dashboard": "ts-node-dev --transpile-only src/db/test_student_dashboard.ts",
    "test:faculty-dashboard": "ts-node-dev --transpile-only src/db/test_faculty_dashboard.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "education",
    "project-management",
    "express",
    "typescript",
    "postgresql",
    "redis"
  ],
  "author": "AIDS Department",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pg-mem": "^3.0.14",
    "rimraf": "^6.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
